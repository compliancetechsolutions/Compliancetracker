# ── Compliance Platform — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# In production use a secret manager (AWS Secrets Manager / GCP Secret Manager /
# HashiCorp Vault) and inject secrets at runtime.

# ── JWT (CRITICAL SECURITY) ───────────────────────────────────────────────────
# Must be at least 32 characters (256 bits) — use a cryptographically random value:
#   openssl rand -hex 32
JWT_SECRET=compliance-secret-key-local-dev-use-only-32chars

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=Zaq@12wsx#

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ── Application ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Use * for local dev ONLY — always specify exact origins in production
ALLOWED_ORIGINS=http://localhost:3000

# Log level: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Distributed tracing sample rate: 0.0 (none) → 1.0 (all)
# Use 0.1 (10%) in production to control overhead
TRACE_SAMPLING=0.1

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
